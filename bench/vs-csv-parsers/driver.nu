#!/usr/bin/env nu
# zsift vs rust-csv — benchfence level-2 comparison driver (structured corpora:
# clean/quoted/escapey, generated by gen.py into ./corpus). Each unit runs a
# parser single-shot (prints BENCHFENCE_METRIC=<MB/s>); benchfence gates + repeats.
#
# Like zsift's own bench.nu, the benchfence lib path below is hardcoded — edit it
# if your benchfence lives elsewhere (nushell `use` needs a literal path).
use /home/astralibernis/projects/benchfence/lib/driver.nu *

const HERE  = path self | path dirname
def zsift [] { $HERE | path dirname | path dirname | path join zig-out bin bench }
def rust  [] { $HERE | path join rustcsv target release rustcsv-bench }
def corp  [c] { $HERE | path join corpus $"($c).csv" }

def units [] {
    let corpora = [clean quoted escapey]
    $corpora | each {|c|
        [
            {name: $"zsift/push/($c)",      do: {|core| with-env {ZSIFT_CORPUS: (corp $c)} { pinned $core [(zsift) x push] }}}
            {name: $"zsift/pull/($c)",      do: {|core| with-env {ZSIFT_CORPUS: (corp $c)} { pinned $core [(zsift) x pull] }}}
            {name: $"rust/byterecord/($c)", do: {|core| pinned $core [(rust) byterecord (corp $c)] }}
            {name: $"rust/core/($c)",       do: {|core| pinned $core [(rust) core (corp $c)] }}
        ]
    } | flatten
}
def main [--reps: int = 15, --out: string = "results/structured.json"] {
    drive (units) --reps $reps --metric "MB/s" --direction higher --out $out | ignore
}
