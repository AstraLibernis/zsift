#!/usr/bin/env nu
# zsift vs rust-csv — benchfence UNITS comparison driver (structured corpora: clean/quoted/escapey,
# generated by gen.py into ./corpus). Each unit runs a parser single-shot (prints
# BENCHFENCE_METRIC=<MB/s>); benchfence gates + repeats. The corpus path is the unit's trailing
# argv arg — benchfence execs argv directly, so there is no $ZSIFT_CORPUS env and no pinning here.

use ../units.nu *

const HERE = (path self | path dirname)
def zsift-bin [] { $HERE | path dirname | path dirname | path join zig-out bin bench }
def rust-bin  [] { $HERE | path join rustcsv target release rustcsv-bench }
def corp [c] { $HERE | path join corpus $"($c).csv" }

def units []: nothing -> list {
    let zsift = (zsift-bin)
    let rust = (rust-bin)
    [clean quoted escapey] | each {|c|
        let f = (corp $c)
        [
            {name: $"zsift/push/($c)",      argv: [$zsift x push $f]}
            {name: $"zsift/pull/($c)",      argv: [$zsift x pull $f]}
            {name: $"rust/byterecord/($c)", argv: [$rust byterecord $f]}
            {name: $"rust/core/($c)",       argv: [$rust core $f]}
        ]
    } | flatten
}

def main [--reps: int = 15, --wait: string = "normal", --out: string = ""] {
    let o = (if ($out | is-empty) { $HERE | path join results structured.json } else { $out })
    run-units (units) --reps $reps --wait $wait --out $o
}
